{
  "name": "ai-landing-page-builder",
  "private": true,
  "version": "0.1.0",
  "description": "AI Landing Page Builder for Shopify (Wishluck take-home)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "theme:build": "node scripts/build-theme.mjs",
    "theme:check": "node scripts/build-theme.mjs && shopify theme check --path shopify/dist/theme",
    "theme:zip": "node scripts/build-theme.mjs --zip",
    "typecheck": "npm run -w backend typecheck",
    "test": "npm run -w backend test",
    "render:demo": "npm run -w backend render:demo && node scripts/build-theme.mjs --extra storage/generated/demo --zip",
    "preview:serve": "node scripts/serve-static.mjs storage/generated 4310",
    "dev:frontend": "npm run -w frontend dev",
    "dev:backend": "npm run -w backend dev",
    "docker:up": "docker compose up --build",
    "evaluate": "node scripts/evaluate.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "archiver": "^7.0.1"
  }
}
