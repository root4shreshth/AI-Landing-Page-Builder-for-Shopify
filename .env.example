# Copy to backend/.env and fill in. Never commit real values.

# --- Database (docker compose default) ---
DATABASE_URL=postgresql://lpb:lpb_dev_password@localhost:5440/lpb?schema=public

# --- AI ---
ANTHROPIC_API_KEY=
# Optional: only if you route through a proxy/gateway
ANTHROPIC_BASE_URL=
# Haiku for both keeps a run cheap; set MAIN to claude-sonnet-5-5 for higher-quality design plans.
LLM_MODEL_MAIN=claude-haiku-5-5
LLM_MODEL_FAST=claude-haiku-5-5

# --- Competitor search (any one is enough; none = paste competitor URLs manually) ---
# auto = first configured of serper, tavily, brave
SEARCH_PROVIDER=auto
# serper.dev — Google results, free starter credits, no card at signup
SERPER_API_KEY=
# tavily.com — free monthly credits, no card at signup
TAVILY_API_KEY=
# Brave Search API — requires a card on file
BRAVE_API_KEY=

# --- Shopify (CLI login only; no Admin API token required) ---
# Your development store domain, e.g. my-dev-store.myshopify.com
SHOPIFY_STORE=
# Storefront password of the dev store (used only for Lighthouse / cart tests against previews)
SHOPIFY_STOREFRONT_PASSWORD=

# --- App ---
PORT=4100
STORAGE_DIR=./storage
CRAWL_USER_AGENT=LandingPageBuilderBot/0.1 (+research; respects robots.txt)
CRAWL_MAX_CONCURRENCY=3

# --- Hosted deployments (Render etc.) ---
# Shared access password for dashboard + API (HTTP Basic, any username). Leave empty for local use.
APP_PASSWORD=
# Caps on actions that spend LLM credits (per visitor / in total, per hour)
MAX_RUNS_PER_CLIENT_HOUR=6
MAX_RUNS_PER_HOUR=20
# 512 MB hosts: LOW_MEMORY=1 (one job at a time, no scripts/fonts while crawling); LIGHTHOUSE=off skips Lighthouse
LOW_MEMORY=
LIGHTHOUSE=
# Theme Access password: lets the Shopify CLI deploy from a server without an interactive login
SHOPIFY_CLI_THEME_TOKEN=

# Only for scripts/copy-db.sh: where to copy the local database (e.g. Supabase Session pooler URL). Never commit.
TARGET_DATABASE_URL=
