{%- comment -%}
  Spike section: proves custom section + schema settings + blocks + live product data
  render in Dawn and are editable in the theme editor. Replaced by the real library in M1.
{%- endcomment -%}
{%- liquid
  assign heading_font = section.settings.heading_font
  assign current_variant = product.selected_or_first_available_variant
-%}
<style>
  {{ heading_font | font_face: font_display: 'swap' }}
  #lp-test-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: 3rem 1.5rem;
  }
  #lp-test-{{ section.id }} .lp-test__heading {
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-weight: {{ heading_font.weight }};
    margin: 0 0 1rem;
  }
  #lp-test-{{ section.id }} .lp-test__inner { max-width: 72rem; margin: 0 auto; }
  #lp-test-{{ section.id }} ul { padding-left: 1.2rem; }
</style>

<div id="lp-test-{{ section.id }}" class="lp-test">
  <div class="lp-test__inner">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 800, 1200', sizes: '(min-width: 750px) 50vw, 100vw' }}
    {%- endif -%}
    <h2 class="lp-test__heading">{{ section.settings.heading | default: product.title | escape }}</h2>
    {%- if section.settings.show_price and product != blank -%}
      <p class="lp-test__price">{{ current_variant.price | money }}</p>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="lp-test__text">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <ul>
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>{{ block.settings.title | escape }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "LP spike section",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Landing page spike" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Editable from the theme editor.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "assistant_n4" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#121212" },
    { "type": "checkbox", "id": "show_price", "label": "Show price", "default": true }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "A point" }
      ]
    }
  ],
  "presets": [
    { "name": "LP spike section" }
  ]
}
{% endschema %}
