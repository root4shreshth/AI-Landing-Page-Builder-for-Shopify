{%- comment -%}
  FAQ (AEO): short, self-contained answers + FAQPage structured data generated from the same blocks,
  so the schema always matches the visible content. Uses <details> (no JS).
{%- endcomment -%}
{{ 'lp.css' | asset_url | stylesheet_tag }}
{% render 'lp-style', section: section %}
{%- assign s = section.settings -%}
<div class="lp lp-faq lp-faq--{{ s.style }} lp--{{ s.lp_width }}">
  <div class="lp__wrap">
    <div class="lp-faq__cols">
      {% render 'lp-head', eyebrow: s.eyebrow, heading: s.heading, intro: s.intro, align: s.align %}
      <div class="lp-faq__list">
        {%- for block in section.blocks -%}
          <details {{ block.shopify_attributes }}{% if forloop.first and s.open_first %} open{% endif %}>
            <summary><h3 class="lp-h3" style="display:inline;font-size:inherit;margin:0">{{ block.settings.question | escape }}</h3></summary>
            <div class="lp-faq__a lp-rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{%- if s.schema and section.blocks.size > 0 -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
      {
        "@type": "Question",
        "name": {{ block.settings.question | strip | json }},
        "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | strip | json }} }
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
{%- endif -%}

{% schema %}
{
  "name": "LP FAQ",
  "tag": "section",
  "class": "section lp-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered" },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "select", "id": "style", "label": "Style", "default": "lines", "options": [
      { "value": "lines", "label": "Lines" }, { "value": "cards", "label": "Cards" }, { "value": "split", "label": "Heading beside questions" }
    ] },
    { "type": "select", "id": "align", "label": "Heading alignment", "default": "left", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }
    ] },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": false },
    { "type": "checkbox", "id": "schema", "label": "Add FAQ structured data", "default": true, "info": "Use only one FAQ section with structured data per page." },
    "__LP_STYLE__"
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "limit": 20,
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What is it made of?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Give a short, direct answer that makes sense on its own.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "LP FAQ", "blocks": [{ "type": "qa" }, { "type": "qa" }] }]
}
{% endschema %}
