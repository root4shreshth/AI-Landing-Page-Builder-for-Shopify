{%- comment -%}
  Fact strip: a few big, quotable product facts (e.g. "400 GSM — Fabric weight"). Filled only from the
  product's real specifications; editable as blocks. Good for scanning and for AI search (GEO).
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- if section.blocks.size > 0 -%}
{{ 'lp.css' | asset_url | stylesheet_tag }}
{% render 'lp-style', section: section %}
<div class="lp lp-facts lp--{{ s.lp_width }}" style="--lp-facts-cols: {{ section.blocks.size | at_most: 4 }};">
  <div class="lp__wrap">
    {%- if s.heading != blank -%}<h2 class="lp-h2">{{ s.heading | escape }}</h2>{%- endif -%}
    <dl class="lp-facts__grid">
      {%- for block in section.blocks -%}
        <div class="lp-fact" {{ block.shopify_attributes }}>
          <dt class="lp-sr">{{ block.settings.label | escape }}</dt>
          <dd style="margin:0">
            <span class="lp-fact__value">{{ block.settings.value | escape }}</span>
            <span class="lp-fact__label" aria-hidden="true">{{ block.settings.label | escape }}</span>
          </dd>
        </div>
      {%- endfor -%}
    </dl>
  </div>
</div>
{%- elsif request.design_mode -%}
  <div class="page-width"><p class="lp-placeholder">LP Fact strip is hidden: add facts as blocks.</p></div>
{%- endif -%}

{% schema %}
{
  "name": "LP Fact strip",
  "tag": "section",
  "class": "section lp-section",
  "settings": [
    { "type": "paragraph", "content": "Big, factual numbers or values from the product (weight, material, capacity). Only use true facts." },
    { "type": "text", "id": "heading", "label": "Heading" },
    "__LP_STYLE__"
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "100%" },
        { "type": "text", "id": "label", "label": "Label", "default": "Cotton" }
      ]
    }
  ],
  "presets": [{ "name": "LP Fact strip", "blocks": [{ "type": "fact" }, { "type": "fact" }, { "type": "fact" }] }]
}
{% endschema %}
