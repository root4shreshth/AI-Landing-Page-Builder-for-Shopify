{%- comment -%}
  Factual specifications (GEO: quotable facts). Spec rows + optional "who it's for" / "in the box" notes.
{%- endcomment -%}
{{ 'lp.css' | asset_url | stylesheet_tag }}
{% render 'lp-style', section: section %}
{%- assign s = section.settings -%}
{%- assign rows = section.blocks | where: 'type', 'spec' -%}
{%- assign notes = section.blocks | where: 'type', 'note' -%}
<div class="lp lp-specs lp--{{ s.lp_width }}">
  <div class="lp__wrap">
    <div class="lp-specs__cols{% if s.layout == 'split' %} lp-specs__cols--split{% endif %}">
      <div>
        {% render 'lp-head', eyebrow: s.eyebrow, heading: s.heading, intro: s.intro %}
        {%- for block in notes -%}
          <div {{ block.shopify_attributes }} style="margin-bottom:2rem">
            <h3>{{ block.settings.title | escape }}</h3>
            <div class="lp-rte">{{ block.settings.text }}</div>
          </div>
        {%- endfor -%}
      </div>
      {%- if rows.size > 0 -%}
        <table class="lp-specs__table">
          <caption class="lp-sr">{{ s.heading | default: 'Specifications' | escape }} — {{ product.title | escape }}</caption>
          <tbody>
            {%- for block in rows -%}
              <tr {{ block.shopify_attributes }}>
                <th scope="row">{{ block.settings.label | escape }}</th>
                <td>{{ block.settings.value | escape }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "LP Specifications",
  "tag": "section",
  "class": "section lp-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Specifications" },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "select", "id": "layout", "label": "Layout (desktop)", "default": "split", "options": [
      { "value": "split", "label": "Heading beside table" }, { "value": "stacked", "label": "Stacked" }
    ] },
    "__LP_STYLE__"
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec row",
      "limit": 30,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Material" },
        { "type": "text", "id": "value", "label": "Value", "default": "Add a factual value" }
      ]
    },
    {
      "type": "note",
      "name": "Fact note",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Who it's for" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>State facts only.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "LP Specifications", "blocks": [{ "type": "spec" }, { "type": "spec" }] }]
}
{% endschema %}
