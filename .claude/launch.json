{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "previews",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/serve-static.mjs",
        "storage/generated",
        "4310"
      ],
      "port": 4310
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "-w",
        "backend",
        "dev"
      ],
      "port": 4100
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "-w",
        "frontend",
        "dev"
      ],
      "port": 5180
    }
  ]
}
